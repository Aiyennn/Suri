```gitignore
# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Testing & coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================
# IDEs & editors
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log

# =========================
# Local databases
# =========================
*.db
*.sqlite
*.sqlite3

# =========================
# Uploaded/generated files
# =========================
uploads/
tmp/
temp/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/
```
